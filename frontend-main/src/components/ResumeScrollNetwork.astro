---
// Lewy pasek: gęsta sieć punktów i połączeń (jak ParticleNetwork); od dołu wypełnienie
// ciemnym tłem wg scrolla — bez poziomych linii podziału.
---

<div class="resume-scroll-network-root" aria-hidden="true">
	<div class="resume-scroll-network-inner">
		<canvas id="resume-scroll-network-canvas" class="resume-scroll-network-canvas" width="140" height="400"></canvas>
	</div>
</div>

<script>
	(function initResumeScrollNetwork() {
		const root = document.querySelector('.resume-scroll-network-root');
		const canvas = document.getElementById('resume-scroll-network-canvas');
		if (!canvas || !(canvas instanceof HTMLCanvasElement) || !root) return;

		const ctx = canvas.getContext('2d');
		if (!ctx) return;

		const ROWS = 58;
		const COLS = 5;
		/* Sąsiedzi przy szerszym rozstawie poziomym — nieco większy zasięg krawędzi. */
		const MAX_DIST = 50;
		const MAX_DIST_SQ = MAX_DIST * MAX_DIST;
		/** Rozstaw poziomy od środka: 1.5 = o 50% szerzej niż siatka „domyślna”. */
		const HORIZONTAL_SPREAD = 1.5;
		/** Maks. „kąt obrotu” w radianach (symulacja 3D: scaleX = cos(yaw)). */
		const YAW_MAX_RAD = Math.PI / 2.05;

		/** @type {{ x: number; y: number; vx: number; vy: number }[]} */
		let nodes = [];
		let w = 0;
		let h = 0;
		let dpr = 1;
		let raf = 0;
		/** Ostatnia pozycja scrolla strony — do przesuwania sieci w górę przy przewijaniu. */
		let lastScrollY = window.scrollY;
		const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		/* Ile pikseli przesuwa się pole przy 1 px scrolla dokumentu (wyraźny „przenośnik”). */
		const SCROLL_FLOW = 0.62;
		const PAD = 2.5;

		function scrollRatio() {
			const el = document.documentElement;
			const max = Math.max(1, el.scrollHeight - window.innerHeight);
			return Math.min(1, Math.max(0, window.scrollY / max));
		}

		function buildNodes() {
			nodes = [];
			const padX = 4;
			const padY = 3;
			const cx = w * 0.5;
			const innerW = w - 2 * padX;
			const innerH = h - 2 * padY;
			const colW = innerW / COLS;
			const rowH = innerH / ROWS;

			for (let r = 0; r < ROWS; r++) {
				/* Przesunięcie co drugi rząd — zrywa pionowe „słupy” kolumn. */
				const stagger = (r % 2) * colW * 0.48;
				/* Lekka fala wzdłuż wysokości — nierówna lewa/prawa krawędź chmury. */
				const waveX = Math.sin(r * 0.38 + 1.2) * (w * 0.06) + Math.cos(r * 0.17) * (w * 0.035);

				for (let c = 0; c < COLS; c++) {
					const baseX = padX + ((c + 0.5) / COLS) * innerW + stagger;
					let bx = cx + (baseX - cx) * HORIZONTAL_SPREAD + waveX;
					/* Nieregularny „organic” szum — większy niż wcześniej, by nie wyglądało jak kratownica. */
					bx +=
						Math.sin(r * 0.71 + c * 1.05) * (w * 0.045) +
						(Math.random() - 0.5) * 11 +
						(Math.random() - 0.5) * 6 * (c % 2 ? 1 : -1);

					const baseY = padY + ((r + 0.5) / ROWS) * innerH;
					let by =
						baseY +
						Math.sin(c * 0.88 + r * 0.29) * (rowH * 0.42) +
						(Math.random() - 0.5) * (rowH * 0.62);

					bx = Math.max(2.5, Math.min(w - 2.5, bx));
					by = Math.max(2.5, Math.min(h - 2.5, by));

					nodes.push({
						x: bx,
						y: by,
						vx: (Math.random() - 0.5) * 0.2,
						vy: 0,
					});
				}
			}
		}

		function resize() {
			const rect = root.getBoundingClientRect();
			dpr = Math.min(window.devicePixelRatio || 1, 2);
			w = Math.max(40, Math.floor(rect.width));
			h = Math.max(80, Math.floor(rect.height));
			canvas.width = Math.floor(w * dpr);
			canvas.height = Math.floor(h * dpr);
			canvas.style.width = `${w}px`;
			canvas.style.height = `${h}px`;
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			buildNodes();
			lastScrollY = window.scrollY;
		}

		/**
		 * Scroll w dół → delta > 0 → y maleje → kropki idą w górę.
		 * Wyjście poza pasek = wrap z lekkim losowaniem („pojawiają się następne”).
		 */
		function applyScrollFlow() {
			const sy = window.scrollY;
			let delta = sy - lastScrollY;
			lastScrollY = sy;
			if (Math.abs(delta) > 140) delta = Math.sign(delta) * 140;
			const move = delta * SCROLL_FLOW * (prefersReducedMotion ? 0.35 : 1);
			for (let i = 0; i < nodes.length; i++) {
				const p = nodes[i];
				p.y -= move;
				if (p.y < PAD) {
					p.y = h - PAD - Math.random() * 12;
					p.x = Math.max(PAD, Math.min(w - PAD, p.x + (Math.random() - 0.5) * 16));
				} else if (p.y > h - PAD) {
					p.y = PAD + Math.random() * 12;
					p.x = Math.max(PAD, Math.min(w - PAD, p.x + (Math.random() - 0.5) * 16));
				}
			}
		}

		/* Tylko dryf poziomy — pion kontroluje scroll (przenośnik). */
		function step() {
			for (const p of nodes) {
				p.x += p.vx;
				if (p.x < PAD || p.x > w - PAD) p.vx *= -1;
				p.x = Math.max(PAD, Math.min(w - PAD, p.x));
			}
		}

		function drawBands(progress) {
			const bandH = h / ROWS;
			for (let bi = 0; bi < ROWS; bi++) {
				const y0 = h - (bi + 1) * bandH;
				const filled = progress > bi / ROWS;
				if (filled) {
					ctx.fillStyle = 'rgba(16, 18, 22, 0.97)';
					ctx.fillRect(0, y0, w, bandH);
				}
			}
		}

		function drawConnections() {
			for (let i = 0; i < nodes.length; i++) {
				for (let j = i + 1; j < nodes.length; j++) {
					const a = nodes[i];
					const b = nodes[j];
					const dx = a.x - b.x;
					const dy = a.y - b.y;
					const dsq = dx * dx + dy * dy;
					if (dsq > MAX_DIST_SQ) continue;
					const d = Math.sqrt(dsq);
					const t = 1 - d / MAX_DIST;
					const alpha = 0.22 + t * 0.52;
					ctx.beginPath();
					ctx.strokeStyle = `rgba(210, 218, 232, ${alpha})`;
					ctx.lineWidth = 1.35;
					ctx.lineCap = 'round';
					ctx.moveTo(a.x, a.y);
					ctx.lineTo(b.x, b.y);
					ctx.stroke();
				}
			}
		}

		function drawNodes(progress) {
			for (let i = 0; i < nodes.length; i++) {
				const p = nodes[i];
				const fromBottom = (h - p.y) / h;
				const inDark = progress > fromBottom;
				ctx.beginPath();
				const alpha = inDark ? 0.75 : 0.45 + (p.x % 7) * 0.02;
				ctx.fillStyle = inDark ? `rgba(235, 238, 245, ${alpha})` : `rgba(200, 208, 222, ${alpha})`;
				ctx.arc(p.x, p.y, 1.75, 0, Math.PI * 2);
				ctx.fill();
			}
		}

		function frame() {
			const progress = scrollRatio();
			applyScrollFlow();
			step();

			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			ctx.clearRect(0, 0, w, h);

			/* Piruet wokół pionowej osi — w Canvas 2D: scaleX(cos θ) względem środka (CSS rotateY często nie działa z canvas). */
			const mul = prefersReducedMotion ? 0.32 : 1;
			const yaw = progress * YAW_MAX_RAD * mul;
			const sx = Math.max(0.1, Math.cos(yaw));

			ctx.save();
			ctx.translate(w * 0.5, h * 0.5);
			ctx.scale(sx, 1);
			ctx.translate(-w * 0.5, -h * 0.5);

			drawBands(progress);
			drawConnections();
			drawNodes(progress);
			ctx.restore();

			raf = requestAnimationFrame(frame);
		}

		const ro = new ResizeObserver(() => resize());
		ro.observe(root);

		resize();
		/* Drugi pomiar po layoutcie — od razu docelowe w,h, kulki nie „wskakują” z pustego środka. */
		requestAnimationFrame(() => {
			resize();
			raf = requestAnimationFrame(frame);
		});

		document.addEventListener(
			'astro:before-swap',
			() => {
				cancelAnimationFrame(raf);
				ro.disconnect();
			},
			{ once: true },
		);
	})();
</script>

<style>
	.resume-scroll-network-root {
		width: 100%;
		height: 100%;
		min-height: 0;
		pointer-events: none;
	}

	.resume-scroll-network-inner {
		width: 100%;
		height: 100%;
		min-height: 0;
	}

	.resume-scroll-network-canvas {
		display: block;
		width: 100%;
		height: 100%;
	}
</style>
