---
import Layout from '../layouts/Layout.astro';
import ParticleNetwork from '../components/ParticleNetwork.astro';
---

<Layout>
	<ParticleNetwork />
	<main class="resume-page" id="top">
		<header class="resume-site-header">
			<div class="resume-site-header-inner">
				<a href="/" class="resume-site-brand">MKravczak.com</a>
				<nav class="resume-site-nav" aria-label="Portfolio sections">
					<a href="#experience">Experience</a>
					<a href="#education">Education &amp; courses</a>
					<a href="#projects">Projects</a>
					<a href="#about">About me</a>
				</nav>
				<div class="resume-site-social">
					<a
						class="resume-site-social-link"
						href="https://github.com/Mikolaj-Krawczak"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="GitHub profile"
					>
						<svg class="resume-site-social-icon" viewBox="0 0 24 24" aria-hidden="true">
							<path
								fill="currentColor"
								d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"
							></path>
						</svg>
					</a>
					<a
						class="resume-site-social-link"
						href="https://www.linkedin.com/in/miko%C5%82aj-krawczak-aa88962b9/"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="LinkedIn profile"
					>
						<svg class="resume-site-social-icon" viewBox="0 0 24 24" aria-hidden="true">
							<path
								fill="currentColor"
								d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.063 2.063 0 1.139-.925 2.065-2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
							></path>
						</svg>
					</a>
				</div>
			</div>
		</header>

		<div class="resume-inner">
			<h1 class="resume-heading">Resume</h1>
			<p class="resume-lead">This is the next section of my portfolio.</p>
			<p class="resume-back">
				<a href="/" class="resume-back-link">
					<span class="resume-back-arrow" aria-hidden="true">←</span>
					<span class="resume-back-text">Back to home</span>
				</a>
			</p>

			<section id="experience" class="resume-section" aria-labelledby="h-exp">
				<h2 id="h-exp" class="resume-section-title">Experience</h2>
			</section>
			<section id="education" class="resume-section" aria-labelledby="h-edu">
				<h2 id="h-edu" class="resume-section-title">Education &amp; courses</h2>
			</section>
			<section id="projects" class="resume-section" aria-labelledby="h-proj">
				<h2 id="h-proj" class="resume-section-title">Projects</h2>
			</section>
			<section id="about" class="resume-section" aria-labelledby="h-about">
				<h2 id="h-about" class="resume-section-title">About me</h2>
			</section>
		</div>
	</main>
</Layout>

<style is:global>
	html {
		scroll-padding-top: 5.5rem;
	}
</style>

<style>
	.resume-page {
		box-sizing: border-box;
		position: relative;
		z-index: 1;
		min-height: 100vh;
		width: 100%;
		padding: 0;
		background-color: transparent;
		color: #ffffff;
		font-family: var(--font-sans);
		font-size: clamp(1.05rem, 1.35vw, 1.2rem);
	}

	/* —— Pasek nawigacji —— */
	.resume-site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: rgba(16, 16, 16, 0.82);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
	}

	.resume-site-header-inner {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		align-items: center;
		gap: clamp(0.75rem, 2vw, 1.5rem);
		max-width: 1200px;
		margin: 0 auto;
		padding: 0.85rem clamp(1rem, 3vw, 2rem);
	}

	.resume-site-brand {
		justify-self: start;
		font-family: 'Surgena', ui-sans-serif, system-ui, sans-serif;
		font-weight: 600;
		font-size: clamp(1.45rem, 2.85vw, 2rem);
		letter-spacing: 0.02em;
		color: #ffffff;
		text-decoration: none;
		transition:
			opacity 0.25s ease,
			transform 0.25s ease;
	}

	.resume-site-brand:hover {
		opacity: 0.92;
		transform: translateY(-1px);
	}

	.resume-site-nav {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: clamp(0.5rem, 1.8vw, 1.25rem);
		justify-self: center;
	}

	.resume-site-nav a {
		font-family: 'Surgena', ui-sans-serif, system-ui, sans-serif;
		font-weight: 600;
		font-size: clamp(0.98rem, 1.65vw, 1.2rem);
		color: rgba(255, 255, 255, 0.92);
		text-decoration: none;
		white-space: nowrap;
		position: relative;
		padding: 0.35em 0;
		transition:
			color 0.28s ease,
			transform 0.28s ease,
			letter-spacing 0.28s ease;
	}

	.resume-site-nav a::after {
		content: '';
		position: absolute;
		left: 0;
		bottom: 0;
		width: 0;
		height: 2px;
		background: linear-gradient(90deg, rgba(255, 255, 255, 0.2), #ffffff);
		transition: width 0.32s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.resume-site-nav a:hover {
		color: #ffffff;
		transform: translateY(-2px);
		letter-spacing: 0.04em;
	}

	.resume-site-nav a:hover::after {
		width: 100%;
	}

	.resume-site-nav a:focus-visible {
		outline: 2px solid #ffffff;
		outline-offset: 4px;
		border-radius: 4px;
	}

	.resume-site-social {
		justify-self: end;
		display: flex;
		align-items: center;
		gap: 0.65rem;
	}

	.resume-site-social-link {
		display: flex;
		align-items: center;
		justify-content: center;
		color: rgba(255, 255, 255, 0.88);
		transition:
			color 0.25s ease,
			transform 0.25s ease,
			filter 0.25s ease;
	}

	.resume-site-social-link:hover {
		color: #ffffff;
		transform: translateY(-3px) scale(1.08);
		filter: drop-shadow(0 0 10px rgba(255, 255, 255, 0.25));
	}

	.resume-site-social-icon {
		width: 1.75rem;
		height: 1.75rem;
		display: block;
	}

	.resume-inner {
		max-width: 720px;
		margin: 0 auto;
		padding: clamp(1.5rem, 4vw, 3rem);
	}

	.resume-heading {
		margin: 0 0 1rem;
		font-size: clamp(2.1rem, 4.5vw, 2.85rem);
		font-weight: 600;
	}

	.resume-lead {
		margin: 0 0 2rem;
		line-height: 1.6;
		opacity: 0.9;
		font-size: clamp(1.12rem, 2.1vw, 1.35rem);
	}

	.resume-back {
		margin: 0 0 3rem;
	}

	.resume-section {
		scroll-margin-top: 5rem;
		padding-top: 1.5rem;
		margin-bottom: 2.5rem;
		border-top: 1px solid rgba(255, 255, 255, 0.1);
	}

	.resume-section:first-of-type {
		border-top: none;
		padding-top: 0;
	}

	.resume-section-title {
		margin: 0;
		font-family: 'Surgena', ui-sans-serif, system-ui, sans-serif;
		font-weight: 600;
		font-size: clamp(1.4rem, 2.85vw, 1.75rem);
	}

	.resume-back-link {
		display: inline-flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.2em;
		text-decoration: none;
		color: #ffffff;
		opacity: 0.85;
		font-size: clamp(1.05rem, 1.5vw, 1.2rem);
	}

	.resume-back-link:visited,
	.resume-back-link:visited .resume-back-arrow,
	.resume-back-link:visited .resume-back-text {
		color: #ffffff;
	}

	.resume-back-text {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.resume-back-link:hover {
		opacity: 1;
	}

	.resume-back-link:hover .resume-back-text {
		text-decoration-thickness: from-font;
	}

	.resume-back-link:focus-visible {
		outline: 2px solid #ffffff;
		outline-offset: 4px;
		border-radius: 2px;
	}

	@media screen and (max-width: 900px) {
		.resume-site-header-inner {
			grid-template-columns: 1fr;
			justify-items: center;
			text-align: center;
		}

		.resume-site-brand {
			justify-self: center;
		}

		.resume-site-nav {
			justify-content: center;
		}

		.resume-site-social {
			justify-self: center;
		}
	}
</style>
