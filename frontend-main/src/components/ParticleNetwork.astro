---
// Tło: poruszająca się sieć punktów i linii (styl plexus), canvas — bez dodatkowych paczek npm.
---

<canvas
	id="particle-network-bg"
	class="particle-network-canvas"
	width="300"
	height="300"
	aria-hidden="true"
></canvas>

<style>
	.particle-network-canvas {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: 0;
		pointer-events: none;
		display: block;
	}
</style>

<script>
	(function initParticleNetwork() {
		const canvas = document.getElementById('particle-network-bg');
		if (!canvas || !(canvas instanceof HTMLCanvasElement)) return;

		const ctx = canvas.getContext('2d');
		if (!ctx) return;

		let particles = [];
		let raf = 0;
		let w = 0;
		let h = 0;
		let dpr = 1;

		const MAX_DIST = 150;
		const MAX_DIST_SQ = MAX_DIST * MAX_DIST;
		/** Margines wokół kadru zdjęcia (px). Od dołu celowo mniejszy — sieć może być bliżej dolnej krawędzi. */
		const PHOTO_PAD = { left: 18, right: 18, top: 18, bottom: 6 };

		function getPhotoClearRect() {
			const el = document.getElementById('hero-photo-frame');
			if (!el) return null;
			const r = el.getBoundingClientRect();
			if (r.width < 8 || r.height < 8) return null;
			return {
				left: r.left - PHOTO_PAD.left,
				right: r.right + PHOTO_PAD.right,
				top: r.top - PHOTO_PAD.top,
				bottom: r.bottom + PHOTO_PAD.bottom,
			};
		}

		function pointInRect(px, py, rect) {
			return px >= rect.left && px <= rect.right && py >= rect.top && py <= rect.bottom;
		}

		/** Czy odcinek a–b przecina lub wchodzi w prostokąt (żeby nie rysować linii przez zdjęcie). */
		function segmentHitsRect(ax, ay, bx, by, rect) {
			for (let t = 0; t <= 1; t += 0.2) {
				const x = ax + (bx - ax) * t;
				const y = ay + (by - ay) * t;
				if (pointInRect(x, y, rect)) return true;
			}
			return false;
		}

		function repelParticlesFromPhoto() {
			const rect = getPhotoClearRect();
			if (!rect) return;
			const escape = 6;
			for (const p of particles) {
				if (!pointInRect(p.x, p.y, rect)) continue;
				const dLeft = p.x - rect.left;
				const dRight = rect.right - p.x;
				const dTop = p.y - rect.top;
				const dBottom = rect.bottom - p.y;
				const m = Math.min(dLeft, dRight, dTop, dBottom);
				if (m === dLeft) {
					p.x = rect.left - escape;
					p.vx -= 0.35;
				} else if (m === dRight) {
					p.x = rect.right + escape;
					p.vx += 0.35;
				} else if (m === dTop) {
					p.y = rect.top - escape;
					p.vy -= 0.35;
				} else {
					p.y = rect.bottom + escape;
					p.vy += 0.35;
				}
			}
		}

		function resize() {
			dpr = Math.min(window.devicePixelRatio || 1, 2);
			w = window.innerWidth;
			h = window.innerHeight;
			canvas.width = Math.floor(w * dpr);
			canvas.height = Math.floor(h * dpr);
			canvas.style.width = `${w}px`;
			canvas.style.height = `${h}px`;
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			const target = Math.min(100, Math.max(36, Math.floor((w * h) / 22000)));
			if (particles.length !== target) buildParticles(target);
		}

		function buildParticles(n) {
			particles = [];
			const avoid = getPhotoClearRect();
			for (let i = 0; i < n; i++) {
				let x;
				let y;
				let guard = 0;
				do {
					x = Math.random() * w;
					y = Math.random() * h;
					guard++;
				} while (avoid && pointInRect(x, y, avoid) && guard < 40);
				particles.push({
					x,
					y,
					vx: (Math.random() - 0.5) * 0.45,
					vy: (Math.random() - 0.5) * 0.45,
					r: Math.random() * 1.8 + 0.8,
				});
			}
		}

		function step() {
			for (const p of particles) {
				p.x += p.vx;
				p.y += p.vy;
				if (p.x < -20) p.x = w + 20;
				if (p.x > w + 20) p.x = -20;
				if (p.y < -20) p.y = h + 20;
				if (p.y > h + 20) p.y = -20;
			}
			repelParticlesFromPhoto();
		}

		function draw() {
			ctx.clearRect(0, 0, w, h);
			const photoRect = getPhotoClearRect();

			for (let i = 0; i < particles.length; i++) {
				for (let j = i + 1; j < particles.length; j++) {
					const a = particles[i];
					const b = particles[j];
					const dx = a.x - b.x;
					const dy = a.y - b.y;
					const dsq = dx * dx + dy * dy;
					if (dsq > MAX_DIST_SQ) continue;
					if (
						photoRect &&
						segmentHitsRect(a.x, a.y, b.x, b.y, photoRect)
					) {
						continue;
					}
					const d = Math.sqrt(dsq);
					const t = 1 - d / MAX_DIST;
					ctx.beginPath();
					ctx.strokeStyle = `rgba(180, 185, 195, ${0.08 + t * 0.22})`;
					ctx.lineWidth = 0.6;
					ctx.moveTo(a.x, a.y);
					ctx.lineTo(b.x, b.y);
					ctx.stroke();
				}
			}

			for (const p of particles) {
				if (photoRect && pointInRect(p.x, p.y, photoRect)) continue;
				ctx.beginPath();
				const alpha = 0.2 + (p.r / 3) * 0.35;
				ctx.fillStyle = `rgba(210, 215, 225, ${alpha})`;
				ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
				ctx.fill();
			}
		}

		function loop() {
			step();
			draw();
			raf = requestAnimationFrame(loop);
		}

		function onVis() {
			if (document.hidden) cancelAnimationFrame(raf);
			else raf = requestAnimationFrame(loop);
		}

		resize();
		window.addEventListener('resize', resize);
		document.addEventListener('visibilitychange', onVis);
		raf = requestAnimationFrame(loop);

		document.addEventListener(
			'astro:before-swap',
			() => {
				cancelAnimationFrame(raf);
				window.removeEventListener('resize', resize);
				document.removeEventListener('visibilitychange', onVis);
			},
			{ once: true },
		);
	})();
</script>
