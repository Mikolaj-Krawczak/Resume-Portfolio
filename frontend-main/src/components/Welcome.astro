---
// Sekcja powitalna: układ 65% / 35%, tekst po lewej, zdjęcie z public/profilepic.jpg po prawej.
---

<div class="hero-page">
	<div class="hero-grid">
		<div class="hero-copy">
			<h1 class="hero-title">
				<span class="hero-title-lead">Hi, I'm </span><span class="hero-name">Mikołaj</span>
			</h1>
			<!-- Podtytuł tylko na szerokość tekstu; chevron obok, od góry w linii z „resume”, znacznie wyższy -->
			<div class="hero-bottom-row">
				<p class="hero-subtitle">this is my Portfolio & Resume</p>
				<div class="hero-next-perspective">
					<a class="hero-next" href="/resume" aria-label="Continue to portfolio resume section">
						<span class="hero-arrow">
							<svg class="layer d12" viewBox="0 0 120 220" aria-hidden="true">
								<path d="M14 10 L106 110 L14 210" />
							</svg>
							<svg class="layer d11" viewBox="0 0 120 220" aria-hidden="true">
								<path d="M14 10 L106 110 L14 210" />
							</svg>
							<svg class="layer d10" viewBox="0 0 120 220" aria-hidden="true">
								<path d="M14 10 L106 110 L14 210" />
							</svg>
							<svg class="layer d9" viewBox="0 0 120 220" aria-hidden="true">
								<path d="M14 10 L106 110 L14 210" />
							</svg>
							<svg class="layer d8" viewBox="0 0 120 220" aria-hidden="true">
								<path d="M14 10 L106 110 L14 210" />
							</svg>
							<svg class="layer d7" viewBox="0 0 120 220" aria-hidden="true">
								<path d="M14 10 L106 110 L14 210" />
							</svg>
							<svg class="layer d6" viewBox="0 0 120 220" aria-hidden="true">
								<path d="M14 10 L106 110 L14 210" />
							</svg>
							<svg class="layer d5" viewBox="0 0 120 220" aria-hidden="true">
								<path d="M14 10 L106 110 L14 210" />
							</svg>
							<svg class="layer d4" viewBox="0 0 120 220" aria-hidden="true">
								<path d="M14 10 L106 110 L14 210" />
							</svg>
							<svg class="layer d3" viewBox="0 0 120 220" aria-hidden="true">
								<path d="M14 10 L106 110 L14 210" />
							</svg>
							<svg class="layer d2" viewBox="0 0 120 220" aria-hidden="true">
								<path d="M14 10 L106 110 L14 210" />
							</svg>
							<svg class="layer d1" viewBox="0 0 120 220" aria-hidden="true">
								<path d="M14 10 L106 110 L14 210" />
							</svg>
							<svg class="layer front" viewBox="0 0 120 220" aria-hidden="true">
								<path d="M14 10 L106 110 L14 210" />
							</svg>
						</span>
					</a>
				</div>
			</div>
		</div>
		<div class="hero-photo-column">
			<div id="hero-photo-frame" class="hero-photo-frame">
				<img
					class="hero-photo"
					src="/profilepic_censure.png"
					alt="Mikołaj — profile photo"
					loading="eager"
					fetchpriority="high"
				/>
			</div>
		</div>
	</div>
</div>

<style>
	.hero-page {
		box-sizing: border-box;
		position: relative;
		z-index: 1;
		min-height: 100vh;
		min-height: 100dvh;
		width: 100%;
		/* transparent — widać ParticleNetwork z index.astro (test); tło z Layout #101010 */
		background-color: transparent;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: clamp(1.5rem, 4vw, 3rem);
	}

	.hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 65fr) minmax(0, 35fr);
		align-items: center;
		gap: clamp(1.5rem, 4vw, 3rem);
		width: 100%;
		max-width: 1200px;
	}

	.hero-copy {
		padding-right: clamp(0.5rem, 2vw, 2rem);
		min-width: 0;
	}

	.hero-bottom-row {
		display: grid;
		grid-template-columns: max-content minmax(0, 1fr);
		align-items: start;
		column-gap: clamp(1.25rem, 3.5vw, 2.75rem);
	}

	/* Perspektywa jak w przykładzie z Compass (perspective + rotateX / rotateZ) */
	.hero-next-perspective {
		justify-self: start;
		display: inline-block;
		perspective: 1000px;
		perspective-origin: 42% 32%;
	}

	.hero-next {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;

		color: white;
		text-decoration: none;

		perspective: 1000px;

		transform:
			rotateX(32deg)
			rotateY(-5deg)
			rotateZ(-1.5deg)
			translateY(-8px);

		transition: transform 0.45s cubic-bezier(0.34, 1.45, 0.52, 1);
		will-change: transform;
	}

	.hero-next:hover {
		transform:
			rotateX(26deg)
			rotateY(-3deg)
			rotateZ(-0.5deg)
			translateX(18px)
			translateY(-20px)
			scale(1.08);
	}

	.hero-next:focus-visible {
		outline: 2px solid #ffffff;
		outline-offset: 4px;
	}

	.hero-arrow {
		position: relative;
    		width:90px;
    	height:180px;
		display: block;
	}

	.layer {
		position: absolute;
		inset: 0;
		overflow: visible;
	}

	.layer path {
		fill: none;
		stroke-width: 22;
		stroke-linejoin: miter;
		stroke-linecap: butt;
	}

	.d12 { transform: translate(1px, 12px); }
	.d11 { transform: translate(1px, 11px); }
	.d10 { transform: translate(1px, 10px); }
	.d9 { transform: translate(1px, 9px); }
	.d8 { transform: translate(1px, 8px); }
	.d7 { transform: translate(1px, 7px); }
	.d6 { transform: translate(1px, 6px); }
	.d5 { transform: translate(1px, 5px); }
	.d4 { transform: translate(1px, 4px); }
	.d3 { transform: translate(1px, 3px); }
	.d2 { transform: translate(1px, 2px); }
	.d1 { transform: translate(1px, 1px); }

	.d12 path { stroke: #181818; }
	.d11 path { stroke: #1d1d1d; }
	.d10 path { stroke: #222; }
	.d9 path { stroke: #262626; }
	.d8 path { stroke: #2c2c2c; }
	.d7 path { stroke: #323232; }
	.d6 path { stroke: #383838; }
	.d5 path { stroke: #3f3f3f; }
	.d4 path { stroke: #474747; }
	.d3 path { stroke: #505050; }
	.d2 path { stroke: #585858; }
	.d1 path { stroke: #616161; }


	.front path {
			stroke: white;

			animation: arrowBreathing 8s ease-in-out infinite;

			transition: filter .35s;
		}


		@keyframes arrowBreathing {

			0% {
				filter:
					drop-shadow(0 0 4px rgba(255,255,255,.15))
					drop-shadow(0 0 8px rgba(255,255,255,.08));
			}

			50% {
				filter:
					drop-shadow(0 0 12px rgba(255,255,255,.55))
					drop-shadow(0 0 28px rgba(255,255,255,.35))
					drop-shadow(0 0 45px rgba(255,255,255,.15));
			}

			100% {
				filter:
					drop-shadow(0 0 4px rgba(255,255,255,.15))
					drop-shadow(0 0 8px rgba(255,255,255,.08));
			}

		}
	
	.hero-next::after {
	content: "";
	position: absolute;

	left: 50%;
	top: 50%;

	width: 170px;
	height: 260px;

	transform:
		translate(-50%, -50%)
		scale(.75);

	pointer-events: none;

	opacity: 0;

	background:
		radial-gradient(
			ellipse,
			rgba(255,255,255,.14) 0%,
			rgba(255,255,255,.08) 28%,
			rgba(255,255,255,.035) 50%,
			transparent 75%
		);

	filter: blur(18px);

	border-radius: 50%;

	transition:
		opacity .35s ease,
		transform .35s ease;
}
		
	.hero-next:hover::after{

    opacity:1;

    transform:
        translate(-50%,-50%)
        scale(1);

}

	.front path{

		stroke:white;

		filter:
			drop-shadow(0 0 6px rgba(255,255,255,.25));

		transition:filter .35s;

	}

	.hero-next:hover .front path {
		animation-play-state: paused;

		filter:
			drop-shadow(0 0 10px rgba(255,255,255,.7))
			drop-shadow(0 0 25px rgba(255,255,255,.45))
			drop-shadow(0 0 45px rgba(255,255,255,.25));
	}

	.hero-title {
		margin: 0 0 0.75rem;
		font-family: 'Surgena', ui-sans-serif, system-ui, sans-serif;
		font-weight: 600;
		line-height: 1.05;
		color: #ffffff;
		letter-spacing: -0.02em;
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0 0.35em;
	}

	/* „Hi, I'm ” — Surgena; większy bazowy rozmiar całej linii */
	.hero-title-lead {
		font-size: clamp(2.4rem, 5.75vw, 4rem);
	}

	/* Mikołaj — Halfre, nieco większe niż lead (łagodniejszy kontrast niż wcześniej) */
	.hero-name {
		font-family: 'Halfre', ui-sans-serif, system-ui, sans-serif;
		font-weight: 400;
		font-size: clamp(3.6rem, 10vw, 6.75rem);
		letter-spacing: -0.03em;
		line-height: 1;
	}

	.hero-subtitle {
		margin: 0;
		max-width: 100%;
		width: max-content;
		font-size: clamp(1.35rem, 3.2vw, 2rem);
		line-height: 1.5;
		color: #ffffff;
		opacity: 0.92;
		font-weight: 400;
	}

	.hero-photo-column {
		display: flex;
		justify-content: center;
		align-items: center;
		padding: clamp(0.75rem, 2vw, 1.5rem);
	}

	/* Ramka + overlay w kolorze tła: miękkie przejście zamiast ostrej linii cropu / koszuli */
	.hero-photo-frame {
		position: relative;
		width: 100%;
		max-width: 100%;
		border-radius: 12px;
		overflow: hidden;
		line-height: 0;
	}

	.hero-photo-frame::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		top: 28%;
		pointer-events: none;
		border-radius: inherit;
		background: linear-gradient(
			to top,
			#101010 0%,
			rgba(16, 16, 16, 0.94) 12%,
			rgba(16, 16, 16, 0.65) 32%,
			rgba(16, 16, 16, 0.22) 58%,
			transparent 100%
		);
	}

	/* Lekkie wygaszenie lewego/prawego brzegu — mniej widać „ścianę” cropu */
	.hero-photo {
		display: block;
		width: 100%;
		max-width: 100%;
		height: auto;
		-webkit-mask-image: linear-gradient(to right, transparent, #000 5%, #000 95%, transparent);
		mask-image: linear-gradient(to right, transparent, #000 5%, #000 95%, transparent);
		-webkit-mask-size: 100% 100%;
		mask-size: 100% 100%;
	}

	@media screen and (max-width: 768px) {
		.hero-grid {
			grid-template-columns: 1fr;
			text-align: center;
		}

		.hero-copy {
			padding-right: 0;
		}

		.hero-title {
			justify-content: center;
		}

		.hero-bottom-row {
			grid-template-columns: 1fr;
			justify-items: center;
			text-align: center;
		}

		.hero-subtitle {
			width: auto;
			max-width: 22rem;
		}

		.hero-next-perspective {
			justify-self: center;
			margin-top: 1rem;
			perspective-origin: 50% 40%;
		}

		.hero-next {
			transform: rotateX(28deg) rotateY(-4deg) rotateZ(-1deg) translateY(-0.35rem);
		}

		.hero-next:hover {
			transform: rotateX(24deg) rotateY(-3deg) rotateZ(-0.5deg) translateX(0.85rem) translateY(-0.95rem)
				scale(1.07);
		}

		.hero-photo-column {
			max-width: 280px;
			margin-inline: auto;
		}
	}
</style>