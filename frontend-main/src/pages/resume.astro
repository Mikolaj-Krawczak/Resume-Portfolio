---
import Layout from '../layouts/Layout.astro';
import ParticleNetwork from '../components/ParticleNetwork.astro';
---

<Layout>
	<ParticleNetwork />
	<main class="resume-page">
		<div class="resume-inner">
			<h1 class="resume-heading">Resume</h1>
			<p class="resume-lead">This is the next section of my portfolio.</p>
			<p class="resume-back">
				<a href="/" class="resume-back-link">
					<span class="resume-back-arrow" aria-hidden="true">← <span class="resume-back-text">Back to home</span> </span>
					
				</a>
			</p>
		</div>
	</main>
</Layout>

<style>
	/* Pełna szerokość tła — brak białych pasów przy wąskiej kolumnie tekstu */
	.resume-page {
		box-sizing: border-box;
		position: relative;
		z-index: 1;
		min-height: 100vh;
		width: 100%;
		padding: clamp(1.5rem, 4vw, 3rem);
		background-color: transparent;
		color: #ffffff;
		font-family: var(--font-sans);
	}

	.resume-inner {
		max-width: 720px;
		margin: 0 auto;
	}

	.resume-heading {
		margin: 0 0 1rem;
		font-size: clamp(1.75rem, 4vw, 2.25rem);
		font-weight: 600;
	}

	.resume-lead {
		margin: 0 0 2rem;
		line-height: 1.6;
		opacity: 0.9;
	}

	.resume-back {
		margin: 0;
	}

	.resume-back-link {
		display: inline-flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.2em;
		text-decoration: none;
		color: #ffffff;
		opacity: 0.85;
	}

	/* Strzałka i tekst zawsze białe także po odwiedzeniu linku (:visited) */
	.resume-back-link:visited,
	.resume-back-link:visited .resume-back-arrow,
	.resume-back-link:visited .resume-back-text {
		color: #ffffff;
	}

	.resume-back-text {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.resume-back-link:hover {
		opacity: 1;
	}

	.resume-back-link:hover .resume-back-text {
		text-decoration-thickness: from-font;
	}

	.resume-back-link:focus-visible {
		outline: 2px solid #ffffff;
		outline-offset: 4px;
		border-radius: 2px;
	}
</style>
