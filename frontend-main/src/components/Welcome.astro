---
// Sekcja powitalna: układ 65% / 35%, tekst po lewej, zdjęcie z public/profilepic.jpg po prawej.

const ARROW_PATH = 'M 14 10 L 106 110 L 14 210';

// Warstwy bez rozmycia (blur = 0) — pieczone jako zwykłe, przesunięte kopie ścieżki
// zamiast wywołań drop-shadow(). To są dokładnie te same kolory/offsety co wcześniej,
// tylko renderowane jako tanie kształty wektorowe zamiast kosztownych przebiegów filtra.
const restCrispSteps = [
	{ dy: 1, color: '#5c5c5c' },
	{ dy: 2, color: '#525252' },
	{ dy: 3, color: '#484848' },
	{ dy: 4, color: '#3f3f3f' },
	{ dy: 5, color: '#383838' },
	{ dy: 6, color: '#323232' },
	{ dy: 7, color: '#2c2c2c' },
	{ dy: 8, color: '#262626' },
	{ dy: 9, color: '#222222' },
	{ dy: 10, color: '#1c1c1c' },
	{ dy: 11, color: '#181818' },
];

const hoverCrispSteps = [
	...restCrispSteps,
	{ dy: 12, color: '#141414' },
];

// Tylko te warstwy mają realne rozmycie — zostają jako filter, ale jest ich
// dużo mniej niż w oryginalnym łańcuchu (4 zamiast 15, 6 zamiast 18).
const restBlurFilter = [
	'drop-shadow(1px 12px 2px rgba(0, 0, 0, 0.55))',
	'drop-shadow(1px 16px 8px rgba(0, 0, 0, 0.4))',
	'drop-shadow(1px 22px 18px rgba(0, 0, 0, 0.28))',
	'drop-shadow(0 0 14px rgba(255, 255, 255, 0.1))',
].join(' ');

const hoverBlurFilter = [
	'drop-shadow(1px 18px 8px rgba(0, 0, 0, 0.5))',
	'drop-shadow(1px 26px 16px rgba(0, 0, 0, 0.38))',
	'drop-shadow(1px 34px 28px rgba(0, 0, 0, 0.32))',
	'drop-shadow(1px 42px 48px rgba(0, 0, 0, 0.38))',
	'drop-shadow(0 0 18px rgba(255, 255, 255, 0.45))',
	'drop-shadow(0 0 36px rgba(255, 255, 255, 0.2))',
].join(' ');
---

<div class="hero-page">
	<div class="hero-grid">
		<div class="hero-copy">
			<h1 class="hero-title">
				<span class="hero-title-lead">Hi, I'm </span><span class="hero-name">Mikołaj</span>
			</h1>
			<!-- Podtytuł tylko na szerokość tekstu; chevron obok, od góry w linii z „resume”, znacznie wyższy -->
			<div class="hero-bottom-row">
				<p class="hero-subtitle">this is my Portfolio & Resume</p>
				<div class="hero-next-perspective">
					<a
						class="hero-next"
						href="/resume"
						aria-label="Continue to portfolio resume section"
					>
						<span class="hero-next-icon-stack">
							<svg
								class="hero-next-icon hero-next-icon--rest"
								xmlns="http://www.w3.org/2000/svg"
								viewBox="0 0 120 220"
								fill="none"
								aria-hidden="true"
							>
								<g style={`filter: ${restBlurFilter}`}>
									{restCrispSteps.map((step) => (
										<path
											d={ARROW_PATH}
											transform={`translate(1, ${step.dy})`}
											stroke={step.color}
											stroke-width="22"
											stroke-linecap="butt"
											stroke-linejoin="miter"
											stroke-miterlimit="8"
										/>
									))}
									<path
										d={ARROW_PATH}
										stroke="currentColor"
										stroke-width="22"
										stroke-linecap="butt"
										stroke-linejoin="miter"
										stroke-miterlimit="8"
									/>
								</g>
							</svg>
							<svg
								class="hero-next-icon hero-next-icon--hover"
								xmlns="http://www.w3.org/2000/svg"
								viewBox="0 0 120 220"
								fill="none"
								aria-hidden="true"
							>
								<g style={`filter: ${hoverBlurFilter}`}>
									{hoverCrispSteps.map((step) => (
										<path
											d={ARROW_PATH}
											transform={`translate(1, ${step.dy})`}
											stroke={step.color}
											stroke-width="22"
											stroke-linecap="butt"
											stroke-linejoin="miter"
											stroke-miterlimit="8"
										/>
									))}
									<path
										d={ARROW_PATH}
										stroke="currentColor"
										stroke-width="22"
										stroke-linecap="butt"
										stroke-linejoin="miter"
										stroke-miterlimit="8"
									/>
								</g>
							</svg>
						</span>
					</a>
				</div>
			</div>
		</div>
		<div class="hero-photo-column">
			<div id="hero-photo-frame" class="hero-photo-frame">
				<img
					class="hero-photo"
					src="/profilepic_censure.png"
					alt="Mikołaj — profile photo"
					loading="eager"
					fetchpriority="high"
				/>
			</div>
		</div>
	</div>
</div>

<style>
	.hero-page {
		box-sizing: border-box;
		position: relative;
		z-index: 1;
		min-height: 100vh;
		min-height: 100dvh;
		width: 100%;
		/* transparent — widać ParticleNetwork z index.astro (test); tło z Layout #101010 */
		background-color: transparent;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: clamp(1.5rem, 4vw, 3rem);
	}

	.hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 65fr) minmax(0, 35fr);
		align-items: center;
		gap: clamp(1.5rem, 4vw, 3rem);
		width: 100%;
		max-width: 1200px;
	}

	.hero-copy {
		padding-right: clamp(0.5rem, 2vw, 2rem);
		min-width: 0;
	}

	.hero-bottom-row {
		display: grid;
		grid-template-columns: max-content minmax(0, 1fr);
		align-items: start;
		column-gap: clamp(1.25rem, 3.5vw, 2.75rem);
	}

	/* Perspektywa jak w przykładzie z Compass (perspective + rotateX / rotateZ) */
	.hero-next-perspective {
		justify-self: start;
		display: inline-block;
		perspective: 1000px;
		perspective-origin: 42% 32%;
	}

	.hero-next {
		display: block;
		color: #f5f5f5;
		text-decoration: none;
		padding: 0.35rem 0.5rem;
		margin: -0.35rem -0.5rem;
		line-height: 0;
		transform: rotateX(32deg) rotateY(-5deg) rotateZ(-1.5deg) translateY(-0.5rem);
		transform-origin: 50% 55%;
		/* Usunięte preserve-3d — nie ma tu zagnieżdżonych dzieci wymagających wspólnej
		   przestrzeni 3D (to płaska ikona), a preserve-3d utrudnia Chromium tanie
		   cache'owanie warstwy kompozytora podczas animacji transform. */
		transform-style: flat;
		will-change: transform;
		transition: transform 0.45s cubic-bezier(0.34, 1.45, 0.52, 1);
	}

	.hero-next:hover {
		transform: rotateX(26deg) rotateY(-3deg) rotateZ(-0.5deg) translateX(1.125rem) translateY(-1.45rem)
			scale(1.08);
	}

	.hero-next:focus-visible {
		outline: 2px solid #ffffff;
		outline-offset: 4px;
	}

	/* Wrapper trzymający obie warstwy ikony jedna na drugiej; własna warstwa
	   kompozytora, żeby (znacznie mniejszy teraz) filtr rozmycia był
	   cache'owany jako tekstura, a nie liczony na klatkę animacji rodzica. */
	.hero-next-icon-stack {
		position: relative;
		display: block;
		height: clamp(7rem, 18vw, 11.5rem);
		will-change: transform;
	}

	/* Niższy chevron niż wcześniej; szerokość z viewBox */
	.hero-next-icon {
		display: block;
		height: clamp(7rem, 18vw, 11.5rem);
		width: auto;
	}

	.hero-next-icon--hover {
		position: absolute;
		inset: 0;
		opacity: 0;
		transition: opacity 0.4s ease;
	}

	.hero-next:hover .hero-next-icon--hover {
		opacity: 1;
	}

	.hero-title {
		margin: 0 0 0.75rem;
		font-family: 'Surgena', ui-sans-serif, system-ui, sans-serif;
		font-weight: 600;
		line-height: 1.05;
		color: #ffffff;
		letter-spacing: -0.02em;
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0 0.35em;
	}

	/* „Hi, I'm ” — Surgena; większy bazowy rozmiar całej linii */
	.hero-title-lead {
		font-size: clamp(2.4rem, 5.75vw, 4rem);
	}

	/* Mikołaj — Halfre, nieco większe niż lead (łagodniejszy kontrast niż wcześniej) */
	.hero-name {
		font-family: 'Halfre', ui-sans-serif, system-ui, sans-serif;
		font-weight: 400;
		font-size: clamp(3.6rem, 10vw, 6.75rem);
		letter-spacing: -0.03em;
		line-height: 1;
	}

	.hero-subtitle {
		margin: 0;
		max-width: 100%;
		width: max-content;
		font-size: clamp(1.35rem, 3.2vw, 2rem);
		line-height: 1.5;
		color: #ffffff;
		opacity: 0.92;
		font-weight: 400;
	}

	.hero-photo-column {
		display: flex;
		justify-content: center;
		align-items: center;
		padding: clamp(0.75rem, 2vw, 1.5rem);
	}

	/* Ramka + overlay w kolorze tła: miękkie przejście zamiast ostrej linii cropu / koszuli */
	.hero-photo-frame {
		position: relative;
		width: 100%;
		max-width: 100%;
		border-radius: 12px;
		overflow: hidden;
		line-height: 0;
	}

	.hero-photo-frame::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		top: 28%;
		pointer-events: none;
		border-radius: inherit;
		background: linear-gradient(
			to top,
			#101010 0%,
			rgba(16, 16, 16, 0.94) 12%,
			rgba(16, 16, 16, 0.65) 32%,
			rgba(16, 16, 16, 0.22) 58%,
			transparent 100%
		);
	}

	/* Lekkie wygaszenie lewego/prawego brzegu — mniej widać „ścianę” cropu */
	.hero-photo {
		display: block;
		width: 100%;
		max-width: 100%;
		height: auto;
		-webkit-mask-image: linear-gradient(to right, transparent, #000 5%, #000 95%, transparent);
		mask-image: linear-gradient(to right, transparent, #000 5%, #000 95%, transparent);
		-webkit-mask-size: 100% 100%;
		mask-size: 100% 100%;
	}

	@media screen and (max-width: 768px) {
		.hero-grid {
			grid-template-columns: 1fr;
			text-align: center;
		}

		.hero-copy {
			padding-right: 0;
		}

		.hero-title {
			justify-content: center;
		}

		.hero-bottom-row {
			grid-template-columns: 1fr;
			justify-items: center;
			text-align: center;
		}

		.hero-subtitle {
			width: auto;
			max-width: 22rem;
		}

		.hero-next-perspective {
			justify-self: center;
			margin-top: 1rem;
			perspective-origin: 50% 40%;
		}

		.hero-next {
			transform: rotateX(28deg) rotateY(-4deg) rotateZ(-1deg) translateY(-0.35rem);
		}

		.hero-next:hover {
			transform: rotateX(24deg) rotateY(-3deg) rotateZ(-0.5deg) translateX(0.85rem) translateY(-0.95rem)
				scale(1.07);
		}

		.hero-next-icon-stack,
		.hero-next-icon {
			height: clamp(5.75rem, 30vw, 8.5rem);
			width: auto;
		}

		.hero-photo-column {
			max-width: 280px;
			margin-inline: auto;
		}
	}
</style>