---
import SectionShell from '../SectionShell.astro';
import { SECTION_LABELS } from '../../data/portfolioSections';

interface ProjectEntry {
  title: string;
  description: string;
  thumbnailSrc: string;
  thumbnailAlt: string;
  href: string;
}

// TODO: podmień `description` na prawdziwe, krótkie opisy (1-2 zdania) każdego projektu.
const projects: ProjectEntry[] = [
  {
    title: "Rubik's Sensei",
    description: "Desktop app for learning and training with the virtual Rubik's Cube.",
    thumbnailSrc: '/images/projects/rubiks-sensei.png',
    thumbnailAlt: "Rubik's Sensei — miniaturka projektu",
    href: '/projects/rubiks-sensei',
  },
  {
    title: 'Real-time AI Chess Analysis',
    description: 'Real-time AI-powered chess analysis tool for players and coaches.',
    thumbnailSrc: '/images/projects/chess-analysis.png',
    thumbnailAlt: 'Real-time AI Chess Analysis — miniaturka projektu',
    href: '/projects/real-time-ai-chess-analysis',
  },
];
---

<SectionShell id="projects" title={SECTION_LABELS.projects}>
  <div class="project-grid">
    {projects.map((project) => (
      <a class="project-card" href={project.href}>
        <div class="project-thumb-wrap">
          <img
            class="project-thumb"
            src={project.thumbnailSrc}
            alt={project.thumbnailAlt}
            loading="lazy"
          />
        </div>
        <div class="project-card-body">
          <h3 class="project-title">{project.title}</h3>
          <p class="project-description">{project.description}</p>
        </div>
      </a>
    ))}
  </div>
</SectionShell>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.75rem;
  }

  .project-card {
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: 14px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .project-card:hover,
  .project-card:focus-visible {
    transform: translateY(-6px);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45);
    border-color: rgba(255, 255, 255, 0.18);
  }

  .project-card:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 3px;
  }

  .project-thumb-wrap {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.06);
  }

  .project-thumb {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  .project-card:hover .project-thumb,
  .project-card:focus-visible .project-thumb {
    transform: scale(1.06);
  }

  .project-thumb-wrap::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0) 55%);
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .project-card:hover .project-thumb-wrap::after,
  .project-card:focus-visible .project-thumb-wrap::after {
    opacity: 1;
  }

  .project-card-body {
    padding: 1.1rem 1.25rem 1.35rem;
  }

  .project-title {
    margin: 0 0 0.4rem;
    font-size: 1.1rem;
    font-weight: 700;
    color: #ffffff;
    transition: color 0.25s ease, transform 0.25s ease;
    font-family: 'Halfre', ui-sans-serif, system-ui, sans-serif;
    position: relative;
    padding-bottom: 0.25rem;
  }

  /* Underline effect identical to site header nav */
  .project-title::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 2px;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.2), #ffffff);
    transition: width 0.32s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .project-card:hover .project-title::after,
  .project-card:focus-visible .project-title::after {
    width: 100%;
  }

  .project-description {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.7);
  }

  @media (max-width: 640px) {
    .project-grid {
      grid-template-columns: 1fr;
    }
  }
</style>