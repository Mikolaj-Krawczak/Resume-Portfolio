---
import SectionShell from '../SectionShell.astro';
import { SECTION_LABELS } from '../../data/portfolioSections';

interface EducationEntry {
  period: string;
  school: string;
  field: string;
  diploma?: {
    imageSrc: string;
    imageAlt: string;
    tooltip?: string;
  };
}

const educationEntries: EducationEntry[] = [
  {
    period: 'September 2018 – April 2022',
    school: ' Zespół Szkół Nr.1 W Lublinie',
    field: 'IT Technician',
  },
  {
    period: 'October 2022 – February 2026',
    school: 'Cracow University of Technology ',
    field: 'Applied Computer Science (B.Eng.)',
    diploma: {
      imageSrc: '/images/diplomas/politechnika-krakowska-diploma.png',
      imageAlt: 'Politechnika Krakowska diploma (English translation)',
      tooltip: 'Click to view diploma (EN)',
    },
  },
  {
    period: '2024',
    school: 'English Language Certificate (C1)',
    field: 'C1 English proficiency certificate',
    diploma: {
      imageSrc: '/images/diplomas/english-language-certificate-c1.png',
      imageAlt: 'English language certificate C1',
      tooltip: 'Click to view C1 English language certificate',
    },
    
  },
  {
  period: 'May 2026',
  school: 'Cyber Security I',
  field: 'Securitum OSINT and OSPEC Basics',
  diploma: {
    imageSrc: '/images/diplomas/cyber-security-osint-ospec-certificate.png',
    imageAlt: 'Cyber Security I — OSINT and OSPEC Basics certificate',
    tooltip: 'Click to view Cyber Security certificate',
   },
  },
];
---

<SectionShell id="education" title={SECTION_LABELS.education}>
  <ul class="edu-list">
    {educationEntries.map((edu) => (
      <li class="edu-item">
        <div class="edu-item-content">
          <p class="edu-period">{edu.period}</p>
          <p class="edu-school">{edu.school}</p>
          <p class="edu-field">{edu.field}</p>
        </div>

        {edu.diploma && (
          <button
            type="button"
            class="edu-diploma-btn"
            data-diploma-trigger
            data-diploma-src={edu.diploma.imageSrc}
            data-diploma-alt={edu.diploma.imageAlt}
            aria-label={edu.diploma.tooltip ?? 'View diploma'}
          >
            <svg
              class="edu-diploma-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="3" y="3" width="18" height="13" rx="2"></rect>
              <line x1="6.5" y1="7.5" x2="17.5" y2="7.5"></line>
              <line x1="6.5" y1="10.5" x2="14" y2="10.5"></line>
              <circle cx="12" cy="17.5" r="3.2"></circle>
              <path d="M9.6 19.8 8.8 22.5 12 21 15.2 22.5 14.4 19.8"></path>
            </svg>
            <span class="edu-diploma-tooltip">{edu.diploma.tooltip ?? 'Click to view diploma'}</span>
          </button>
        )}
      </li>
    ))}
  </ul>

  <!--
    Modal deklarowany tu, w markupie sekcji, dla wygody — ale w skrypcie poniżej
    jest w locie przenoszony (`appendChild`) do document.body. Dzięki temu jego
    `position: fixed` liczy się względem CAŁEGO viewportu, a nie względem
    najbliższego przodka z transform/filter/perspective (który tworzy nowy
    "containing block" i psuje fixed — to był powód, czemu blur obejmował
    tylko sekcję Education).
  -->
  <div class="diploma-modal" data-diploma-modal hidden>
    <div class="diploma-modal-backdrop" data-diploma-close></div>
    <div class="diploma-modal-dialog" role="dialog" aria-modal="true" aria-label="Diploma preview">
      <button type="button" class="diploma-modal-close" data-diploma-close aria-label="Close">
        &times;
      </button>
      <img class="diploma-modal-image" data-diploma-image src="" alt="" />
    </div>
  </div>
</SectionShell>

<style>
  .edu-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }

  .edu-item {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.5rem;
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.15);
  }

  .edu-item-content {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .edu-period {
    margin: 0;
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.65);
  }

  .edu-school {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.3;
    color: #ffffff;
  }

  .edu-field {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.82);
  }

  .edu-diploma-btn {
    position: relative;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 14px;
    color: rgba(255, 255, 255, 0.75);
    cursor: pointer;
    transition: color 0.2s ease, transform 0.2s ease, filter 0.2s ease, background 0.2s ease;
  }

  .edu-diploma-btn:hover,
  .edu-diploma-btn:focus-visible {
    color: #ffffff;
    transform: translateY(-2px) scale(1.05);
    filter: drop-shadow(0 0 12px rgba(255, 255, 255, 0.2));
    background: rgba(255, 255, 255, 0.12);
  }

  .edu-diploma-icon {
    width: 20px;
    height: 20px;
  }

  .edu-diploma-tooltip {
    position: absolute;
    bottom: calc(100% + 10px);
    right: 0;
    white-space: nowrap;
    background: rgba(10, 16, 29, 0.95);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.4rem 0.65rem;
    border-radius: 8px;
    opacity: 0;
    pointer-events: none;
    transform: translateY(6px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .edu-diploma-btn:hover .edu-diploma-tooltip,
  .edu-diploma-btn:focus-visible .edu-diploma-tooltip {
    opacity: 1;
    transform: translateY(0);
  }

  /* z-index podbity na wszelki wypadek — teraz element i tak wisi bezpośrednio
     pod <body>, więc to głównie zabezpieczenie, gdyby coś innego na stronie
     też miało bardzo wysoki z-index. */
  .diploma-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
  }

  .diploma-modal[hidden] {
    display: none;
  }

  .diploma-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(8, 10, 16, 0.82);
    backdrop-filter: blur(3px);
  }

  .diploma-modal-dialog {
    position: relative;
    max-width: min(90vw, 760px);
    max-height: 85vh;
    background: rgba(10, 16, 29, 0.98);
    border-radius: 18px;
    padding: 1rem;
    box-shadow: 0 28px 80px rgba(0, 0, 0, 0.45);
  }

  .diploma-modal-image {
    display: block;
    max-width: 100%;
    max-height: 75vh;
    border-radius: 12px;
    object-fit: contain;
  }

  .diploma-modal-close {
    position: absolute;
    top: -14px;
    right: -14px;
    width: 34px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 50%;
    background: #ffffff;
    color: #101625;
    font-size: 1.3rem;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.35);
  }
</style>

<script>
  const modal = document.querySelector<HTMLDivElement>('[data-diploma-modal]');

  // Portal: przenosimy modal bezpośrednio pod <body>, żeby uciec spod
  // wpływu jakiegokolwiek przodka z transform/filter/perspective/contain,
  // który tworzyłby własny "containing block" i psuł position: fixed.
  if (modal && modal.parentElement !== document.body) {
    document.body.appendChild(modal);
  }

  const triggers = document.querySelectorAll<HTMLButtonElement>('[data-diploma-trigger]');
  const modalImage = modal?.querySelector<HTMLImageElement>('[data-diploma-image]');
  const closeEls = modal?.querySelectorAll<HTMLElement>('[data-diploma-close]');

  function openDiploma(src: string, alt: string) {
    if (!modal || !modalImage) return;
    modalImage.setAttribute('src', src);
    modalImage.setAttribute('alt', alt);
    modal.removeAttribute('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeDiploma() {
    if (!modal || !modalImage) return;
    modal.setAttribute('hidden', '');
    modalImage.setAttribute('src', '');
    document.body.style.overflow = '';
  }

  triggers.forEach((btn) => {
    btn.addEventListener('click', () => {
      const src = btn.getAttribute('data-diploma-src');
      const alt = btn.getAttribute('data-diploma-alt') ?? 'Diploma';
      if (src) openDiploma(src, alt);
    });
  });

  closeEls?.forEach((el) => el.addEventListener('click', closeDiploma));

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeDiploma();
  });
</script>