---
import Layout from '../../layouts/Layout.astro';
import ParticleNetwork from '../../components/ParticleNetwork.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import ExperienceSection from '../../components/sections/ExperienceSection.astro';
import EducationSection from '../../components/sections/EducationSection.astro';
import ProjectsSection from '../../components/sections/ProjectsSection.astro';
import AboutSection from '../../components/sections/AboutSection.astro';
import { SECTION_SLUGS, SECTION_LABELS, isSectionSlug, type SectionSlug } from '../../data/portfolioSections';

export function getStaticPaths() {
	return SECTION_SLUGS.map((section) => ({ params: { section } }));
}

const param = Astro.params.section;

if (!isSectionSlug(param)) {
	return Astro.redirect('/resume', 302);
}

const section: SectionSlug = param;
---

<Layout>
	<ParticleNetwork />
	<main class="resume-page resume-page--single" id="top">
		<SiteHeader variant="resumeSingle" activeSection={section} />
		<div class="resume-inner resume-inner--single">
			<p class="resume-back">
				<a href="/resume" class="resume-back-link resume-back-link--secondary">
					<span class="resume-back-text">Full resume</span>
				</a>
			</p>

			<p class="resume-single-lead">
				{SECTION_LABELS[section]} — detailed view.
			</p>

			{section === 'experience' && <ExperienceSection />}
			{section === 'education' && <EducationSection />}
			{section === 'projects' && <ProjectsSection />}
			{section === 'about' && <AboutSection />}
		</div>
	</main>
</Layout>

<style is:global>
	html {
		scroll-padding-top: 5.5rem;
	}
</style>

<style>
	.resume-page {
		box-sizing: border-box;
		position: relative;
		z-index: 1;
		min-height: 100vh;
		width: 100%;
		padding: 0;
		background-color: transparent;
		color: #ffffff;
		font-family: var(--font-sans);
		font-size: clamp(1.05rem, 1.35vw, 1.2rem);
	}

	.resume-inner {
		max-width: 720px;
		margin: 0 auto;
		padding: clamp(1.5rem, 4vw, 3rem);
	}

	.resume-back {
		margin: 0 0 1.5rem;
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 1rem 1.5rem;
	}

	.resume-back-link {
		display: inline-flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.2em;
		text-decoration: none;
		color: #ffffff;
		opacity: 0.85;
		font-size: clamp(1.05rem, 1.5vw, 1.2rem);
	}

	.resume-back-link--secondary {
		opacity: 0.7;
	}

	.resume-back-link:visited,
	.resume-back-link:visited .resume-back-arrow,
	.resume-back-link:visited .resume-back-text {
		color: #ffffff;
	}

	.resume-back-text {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.resume-back-link:hover {
		opacity: 1;
	}

	.resume-back-link:hover .resume-back-text {
		text-decoration-thickness: from-font;
	}

	.resume-back-link:focus-visible {
		outline: 2px solid #ffffff;
		outline-offset: 4px;
		border-radius: 2px;
	}

	.resume-single-lead {
		margin: 0 0 2rem;
		line-height: 1.5;
		opacity: 0.88;
		font-size: clamp(1.05rem, 1.9vw, 1.2rem);
	}
</style>
