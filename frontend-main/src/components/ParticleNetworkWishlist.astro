---
// Tło: poruszająca się sieć punktów i linii (styl plexus), canvas — bez dodatkowych paczek npm.
// Wersja dla strony Wishlist z kolorem #f02c7f
---

<canvas
	id="particle-network-wishlist"
	class="particle-network-canvas particle-network-canvas--wishlist"
	width="300"
	height="300"
	aria-hidden="true"
></canvas>

<style>
	.particle-network-canvas--wishlist {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: 0;
		pointer-events: none;
		display: block;
	}
</style>

<script>
	(function initParticleNetworkWishlist() {
		const canvas = document.getElementById('particle-network-wishlist');
		if (!canvas || !(canvas instanceof HTMLCanvasElement)) return;

		const ctx = canvas.getContext('2d');
		if (!ctx) return;

		let particles = [];
		let raf = 0;
		let w = 0;
		let h = 0;
		let dpr = 1;

		const MAX_DIST = 150;
		const MAX_DIST_SQ = MAX_DIST * MAX_DIST;
		const PARTICLE_COUNT = 65;
		const BRAND_COLOR = '#f02c7f';
		const BRAND_COLOR_RGB = '240, 44, 127';

		function resize() {
			dpr = Math.min(window.devicePixelRatio || 1, 2);
			w = window.innerWidth;
			h = window.innerHeight;
			canvas.width = Math.floor(w * dpr);
			canvas.height = Math.floor(h * dpr);
			canvas.style.width = `${w}px`;
			canvas.style.height = `${h}px`;
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			buildParticles();
		}

		function buildParticles() {
			particles = [];
			for (let i = 0; i < PARTICLE_COUNT; i++) {
				particles.push({
					x: Math.random() * w,
					y: Math.random() * h,
					vx: (Math.random() - 0.5) * 0.4,
					vy: (Math.random() - 0.5) * 0.4,
				});
			}
		}

		function step() {
			for (const p of particles) {
				p.x += p.vx;
				p.y += p.vy;

				if (p.x < 0 || p.x > w) p.vx *= -1;
				if (p.y < 0 || p.y > h) p.vy *= -1;

				p.x = Math.max(0, Math.min(w, p.x));
				p.y = Math.max(0, Math.min(h, p.y));
			}
		}

		function drawConnections() {
			for (let i = 0; i < particles.length; i++) {
				for (let j = i + 1; j < particles.length; j++) {
					const a = particles[i];
					const b = particles[j];
					const dx = a.x - b.x;
					const dy = a.y - b.y;
					const dsq = dx * dx + dy * dy;
					if (dsq > MAX_DIST_SQ) continue;

					const d = Math.sqrt(dsq);
					const t = 1 - d / MAX_DIST;
					const alpha = 0.15 + t * 0.35;
					ctx.beginPath();
					ctx.strokeStyle = `rgba(${BRAND_COLOR_RGB}, ${alpha})`;
					ctx.lineWidth = 1.2;
					ctx.lineCap = 'round';
					ctx.moveTo(a.x, a.y);
					ctx.lineTo(b.x, b.y);
					ctx.stroke();
				}
			}
		}

		function drawParticles() {
			for (let i = 0; i < particles.length; i++) {
				const p = particles[i];
				ctx.beginPath();
				const alpha = 0.35 + (Math.random() * 0.25);
				ctx.fillStyle = `rgba(${BRAND_COLOR_RGB}, ${alpha})`;
				ctx.arc(p.x, p.y, 1.5, 0, Math.PI * 2);
				ctx.fill();
			}
		}

		function frame() {
			step();
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			ctx.clearRect(0, 0, w, h);
			drawConnections();
			drawParticles();
			raf = requestAnimationFrame(frame);
		}

		window.addEventListener('resize', () => resize());
		resize();
		raf = requestAnimationFrame(frame);

		document.addEventListener('astro:before-swap', () => {
			cancelAnimationFrame(raf);
		});
	})();
</script>
